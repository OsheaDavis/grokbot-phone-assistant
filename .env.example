# Names only. Leave values empty. Set real values in the environment or Fly secrets.
PORT=
HOST=
NODE_ENV=
DATA_DIR=
PUBLIC_BASE_URL=
XAI_API_KEY=
XAI_VOICE=
XAI_PRONUNCIATION_REPLACE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, used only by scripts/wire-twilio.sh. Also set OUTBOUND_FROM_NUMBER in src/outbound/constants.ts.
TWILIO_PHONE_NUMBER=
SUMMARY_WEBHOOK_URL=
SUMMARY_WEBHOOK_SECRET=
SUMMARY_WEBHOOK_AUTH=
MESSAGES_BEARER_TOKEN=
CALLERS_CONFIG=
GREETINGS_CONFIG=
RETENTION_DAYS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_TWILIO_MAX=
RATE_LIMIT_MESSAGES_MAX=
SUMMARY_TIMEOUT_MS=
SUMMARY_MAX_ATTEMPTS=
SUMMARY_RETRY_BASE_MS=
MAX_CALL_MS=
SPAM_REPEAT_MAX=
SPAM_REPEAT_WINDOW_MS=
ALLOW_INSECURE_DEV_WEBHOOK=
DEBUG_XAI_EVENTS=
# Outbound is off when OUTBOUND_ENABLED is absent. The bearer is not the messages token.
OUTBOUND_ENABLED=
OUTBOUND_BEARER_TOKEN=
# Comma-separated E.164 numbers outbound may dial (stage 1: one). Missing, empty or malformed means no calls. Set it yourself; never commit a real number.
OUTBOUND_ALLOWLIST=
# US E.164 callback number spoken in the opener. Must not be the bot line or an allowlisted number.
OUTBOUND_CALLBACK_NUMBER=
