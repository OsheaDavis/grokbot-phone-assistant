{
  "name": "phone-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 inbound phone assistant for Owner. Takes messages. Does not place calls.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
